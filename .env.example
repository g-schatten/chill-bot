# Copy this file to ".env" and fill it in. Never share or commit ".env".

# ---- Discord -------------------------------------------------------------
DISCORD_TOKEN=
# Your server's ID (right-click server icon -> Copy Server ID; needs Developer Mode on).
# Several servers? Separate with commas. The bot leaves any server not listed here.
GUILD_IDS=
# Your own Discord user ID (enables the owner-only /debug command). Optional.
OWNER_ID=
BOT_PREFIX=!
DEFAULT_VOLUME=60

# ---- Passwords between the containers (make up long random strings) ---------
LAVALINK_PASSWORD=change-me-to-something-long
CIPHER_PASSWORD=change-me-too

# Max Java memory for Lavalink. 1G is fine for a 2GB machine.
LAVALINK_HEAP=1G

# ---- YouTube sign-in (only if you get "sign in to confirm you're not a bot") --
# Use a throwaway Google account, never your main one. See README "Troubleshooting".
YT_OAUTH=false

# ---- Spotify (see README, "Spotify links") -------------------------------
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY=US
SPOTIFY_PREFER_ANON=false
